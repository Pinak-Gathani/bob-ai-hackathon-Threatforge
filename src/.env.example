# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── Backend (src/backend/.env) ──────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# SQLite path (relative to src/backend/) — change to postgresql:// for production
DATABASE_URL=sqlite:///./threatlens.db

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ── Frontend (src/frontend/.env.local) ──────────────────────────────────────
# Backend API base URL consumed by Vite at build time
VITE_API_URL=http://localhost:8000

# ── IBM watsonx.ai — Phase 4 (leave blank until watsonx integration) ────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com


# ── Incident-level notifications (optional) ───────────────────────────────
THREATFORGE_NOTIFICATION_DEMO=true
THREATFORGE_SMTP_HOST=
THREATFORGE_SMTP_PORT=587
THREATFORGE_SMTP_USERNAME=
THREATFORGE_SMTP_PASSWORD=
THREATFORGE_SMTP_FROM=
THREATFORGE_SMTP_TLS=true
THREATFORGE_TWILIO_ACCOUNT_SID=
THREATFORGE_TWILIO_AUTH_TOKEN=
THREATFORGE_TWILIO_FROM_NUMBER=
