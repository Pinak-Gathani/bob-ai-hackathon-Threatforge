THREATFORGE_API_URL=http://127.0.0.1:8000
# ThreatLens AI Backend — Environment Variables
# Copy this file to .env and adjust values

# Application
APP_ENV=development
APP_PORT=8000

# Database — SQLite path (relative to src/backend/)
DATABASE_URL=sqlite:///./threatlens.db

# CORS — comma-separated allowed origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Optional future watsonx.ai model integration (the local evidence engine works without credentials)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Incident notifications (optional; demo mode works without providers)
THREATFORGE_NOTIFICATION_DEMO=true
THREATFORGE_SMTP_HOST=
THREATFORGE_SMTP_PORT=587
THREATFORGE_SMTP_USERNAME=
THREATFORGE_SMTP_PASSWORD=
THREATFORGE_SMTP_FROM=
THREATFORGE_SMTP_TLS=true
THREATFORGE_TWILIO_ACCOUNT_SID=
THREATFORGE_TWILIO_AUTH_TOKEN=
THREATFORGE_TWILIO_FROM_NUMBER=
